// fastfetch con los colores del fondo (lo genera matugen desde
// ~/.config/matugen/templates/fastfetch.jsonc; edita la plantilla, no ~/.config/fastfetch/config.jsonc)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch",
        "color": { "1": "#adc6ff", "2": "#ffb780" },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#adc6ff",
            "title": "#ffb780",
            "separator": "#8c909f",
            "output": "#e1e2eb"
        },
        "key": { "width": 13 },
        "size": { "binaryPrefix": "iec" },
        "percent": {
            "color": {
                "green": "#adc6ff",
                "yellow": "#ffb780",
                "red": "#ffb4ab"
            }
        }
    },
    "modules": [
        "break",
        { "type": "os", "key": "󰣇 Sistema", "format": "{name} {arch}" },
        { "type": "kernel", "key": "\uf17c Kernel" },
        { "type": "wm", "key": "\uf2d2 Ventanas", "format": "{pretty-name} {version}" },
        { "type": "shell", "key": "\uf489 Shell" },
        { "type": "terminal", "key": "\ue795 Terminal" },
        { "type": "packages", "key": "󰏖 Paquetes" },
        { "type": "uptime", "key": "󰅐 Encendido", "format": "{?days}{days} d {?}{?hours}{hours} h {?}{minutes} min" },
        "break",
        { "type": "cpu", "key": "\uf2db CPU", "format": "{name} ({cores-logical})" },
        { "type": "gpu", "key": "󰢮 GPU", "format": "{name}" },
        { "type": "memory", "key": "\uefc5 RAM" },
        { "type": "disk", "key": "󰋊 Disco", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
        { "type": "battery", "key": "󰁹 Batería", "format": "{capacity}" },
        {
            "type": "command",
            "key": "󰂄 Salud",
            "text": "b=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1); [ -n \"$b\" ] || exit 0; [ -r $b/charge_full ] && f=$(cat $b/charge_full) d=$(cat $b/charge_full_design) && printf '%s %% de su capacidad' $((f*100/d)); t=$(cat $b/charge_control_end_threshold 2>/dev/null); [ -n \"$t\" ] && [ \"$t\" -lt 100 ] && printf ' · tope %s %%' $t"
        },
        "break",
        // Muestras de la paleta del fondo (no los colores fijos de la terminal)
        { "type": "custom", "format": "{##adc6ff}● {##b1c6f7}● {##ffb780}● {##ffb4ab}● {##4d8efe}● {##344972}● {##db760f}● {##8c909f}●" }
    ]
}
