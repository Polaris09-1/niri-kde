[Desktop Entry]
# Copia de /usr/share/applications/Alacritty.desktop con ESCRITORIO_TERMINAL=1: es la marca de que
# la terminal la abriste tú (cajón, dock, escritorio) y permite fastfetch (~/.config/bash/escritorio.sh).
# Para volver a la original, borra este archivo.
Type=Application
TryExec=alacritty
Exec=env ESCRITORIO_TERMINAL=1 alacritty
Icon=Alacritty
Terminal=false
Categories=System;TerminalEmulator;

Name=Alacritty
GenericName=Terminal
Comment=A fast, cross-platform, OpenGL terminal emulator
StartupNotify=true
StartupWMClass=Alacritty
Actions=New;

[Desktop Action New]
Name=New Terminal
Exec=env ESCRITORIO_TERMINAL=1 alacritty
